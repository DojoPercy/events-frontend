// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(cuid())
  auth0OrgId  String   @unique
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  events         Event[]
  emailTemplates EmailTemplate[]

  @@map("organizations")
}

model EmailTemplate {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  // Template identification
  type           String   // 'ticket_confirmation', 'ticket_approval', 'ticket_rejection', 'organization_invitation'
  name           String
  
  // Template content
  subject        String
  htmlBody       String   @db.Text
  
  // Customization
  primaryColor   String   @default("#8B5CF6")
  secondaryColor String   @default("#A855F7")
  logoUrl        String?
  
  // Metadata
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@unique([organizationId, type])
  @@map("email_templates")
}

model Event {
  id             String   @id @default(cuid())
  title          String
  description    String?
  slug           String   @unique
  eventDate      DateTime
  endDate        DateTime?
  timezone       String   @default("UTC")
  location       String?
  venue          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  country        String?
  zipCode        String?
  latitude       Float?
  longitude      Float?
  placeId        String?
  imageUrl       String?
  coverImageUrl  String?
  logoUrl        String?
  isPublished    Boolean  @default(false)
  isDraft        Boolean  @default(true)
  
  // Event landing page customization
  primaryColor   String?
  secondaryColor String?
  heroTitle      String?
  heroSubtitle   String?
  aboutSection   String?
  
  // Social media
  website        String?
  linkedinUrl    String?
  twitterUrl     String?
  instagramUrl   String?
  
  // Tax and billing
  currency       String   @default("USD")
  taxRate        Float?
  taxName        String?
  taxInclusive   Boolean  @default(false)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticketTypes    TicketType[]
  purchases      Purchase[]

  @@map("events")
}

model TicketType {
  id               String    @id @default(cuid())
  name             String
  description      String?
  price            Decimal    @db.Decimal(10, 2)
  quantity         Int
  sold             Int       @default(0)
  isActive         Boolean   @default(true)
  requiresApproval Boolean   @default(false)
  customNotes      String?
  maxPerOrder      Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  eventId     String
  event       Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  purchases   Purchase[]

  @@map("ticket_types")
}

model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  purchases Purchase[]

  @@map("customers")
}

model Purchase {
  id          String         @id @default(cuid())
  status      PurchaseStatus @default(PENDING)
  quantity    Int
  
  // Buyer information
  firstName        String
  lastName         String
  email            String
  phone            String?
  company          String?
  designation      String?
  
  // Billing information
  billingName      String
  billingAddressLine1 String
  billingAddressLine2 String?
  billingCity      String
  billingState     String?
  billingCountry   String
  billingZipCode   String
  
  // Pricing
  subtotal         Decimal  @db.Decimal(10, 2)
  taxAmount        Decimal  @db.Decimal(10, 2)
  discount         Decimal  @db.Decimal(10, 2) @default(0)
  totalAmount      Decimal  @db.Decimal(10, 2)
  promoCode        String?
  
  // Approval workflow
  approvalNotes    String?
  rejectionReason  String?
  approvedBy       String?
  approvedAt       DateTime?
  
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relations
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  eventId      String
  event        Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@map("purchases")
}

enum PurchaseStatus {
  PENDING
  APPROVED
  REJECTED
}